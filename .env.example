# Parenthèse self-hosting configuration (docker compose).
# Copy this file to .env next to docker-compose.yml and fill in the three values marked "Required".
# docker compose reads .env from this folder on its own. The file is ignored by git: your secrets
# stay on your machine.
#
# NODE_ENV, PORT, DATABASE_URL and MEDIA_STORAGE_PATH are set by docker-compose.yml,
# no need to define them here.

# ── Images (Docker Hub) ───────────────────────────────────────────────────────
# The API and web images: <IMAGE_NAMESPACE>/parenthese-api and <IMAGE_NAMESPACE>/parenthese-web.
# They are published by `make images` from your machine, or by the Images workflow after CI
# passes on main.
# Required. Your Docker Hub user or organization; `make images` pushes there too.
IMAGE_NAMESPACE=
# latest (the last published build), or a fixed one such as sha-dd1bfbd. The tag must exist on
# Docker Hub, except `local`, which `make images-local` builds on this machine only.
# Update: docker compose pull && docker compose up -d
# Private repositories: run `docker login` on the server once before pulling.
IMAGE_TAG=latest

# ── Database (db container, not exposed outside the Docker network) ──────────
POSTGRES_USER=parenthese
POSTGRES_DB=parenthese
# Required. Letters and digits only: the value goes into a connection URL.
# Set on first start: to change it later, the db-data volume has to be recreated.
POSTGRES_PASSWORD=

# ── API ───────────────────────────────────────────────────────────────────────
# Required, 32 characters or more recommended. Generate one with:
#   openssl rand -base64 48
#   or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# The API refuses to start in production with the development value.
JWT_SECRET=
# Lifetime of account sessions and of access through a shared link.
JWT_EXPIRES_IN=7d
JWT_TREE_ACCESS_EXPIRES_IN=24h
# Address your family opens Parenthèse at, without a trailing slash.
# Locally: http://localhost (or http://localhost:8080 if WEB_PORT=8080).
# Behind an HTTPS reverse proxy: https://tree.your-domain.com
# Several addresses: separate them with commas.
CORS_ORIGIN=http://localhost
# Proxies whose X-Forwarded-For header the API trusts (visitor addresses, attempt limits).
# By default, the nginx of the web container (private Docker network). If you put a reverse proxy
# in front, add its address, for example loopback,uniquelocal,203.0.113.10
# TRUST_PROXY=loopback,uniquelocal
# Disk space per tree (MB), and the part reserved for family uploads waiting for review.
# MEDIA_QUOTA_PER_TREE_MB=5120
# MEDIA_PENDING_QUOTA_PER_TREE_MB=500

# ── Accounts ──────────────────────────────────────────────────────────────────
# false: nobody can create an account any more. Existing accounts sign in and create their trees,
# and family members still open shared trees with the link and password. An instance with no
# account at all still accepts the first one (yours): create it right after the first start,
# before you give out the address.
# ALLOW_REGISTRATION=true
# Sign-up code, for registration that stays open to some people only. When set, creating an
# account asks for it: any value of 4 to 32 characters. Give it to the people who should have an
# account. Relatives who open the tree with its link and password need no account, so no code
# either. Accounts created through the OIDC provider below don't need it. Empty: anyone who
# reaches the site can sign up. Changing it does not affect existing accounts; apply it with:
# docker compose up -d
REGISTRATION_CODE=

# ── Sign-in through an identity provider (OIDC: Authentik, Authelia, Keycloak…) ──
# Off without OIDC_ISSUER. At the provider, redirect URI = public address + /auth/oidc/callback.
# Details in the README, section "Sign in with your identity provider (OIDC)".
# OIDC_ISSUER=https://auth.your-domain.com/application/o/parenthese/
# OIDC_CLIENT_ID=parenthese
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://tree.your-domain.com/auth/oidc/callback
# OIDC_PROVIDER_NAME=Authentik
# Email accepted only when the provider marks it verified (email_verified).
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# false: no Parenthèse passwords any more, sign-in through the provider only.
# PASSWORD_LOGIN=true

# ── Immich (face recognition, off by default) ─────────────────────────────────
# Immich instances allowed on this server, separated by commas. An entry can carry a label,
# "Label=https://address"; without one, its host name is used (one host name cannot serve two
# instances: give them labels). Each tree's administrators pick the instance by its name and
# enter their own API key (created in Immich, Settings > API Keys); the key is stored encrypted.
# Administrators only ever see the label, never the address. Without this list the feature stays
# off, and an address removed from the list cuts off the trees that use it right away.
# IMMICH_ALLOWED_API_URLS=Home=http://immich.home.lan:2283,https://immich.example.org

# ── Web ───────────────────────────────────────────────────────────────────────
# Port published on the host (80 = http://localhost without a port).
WEB_PORT=80
